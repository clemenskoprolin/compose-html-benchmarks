led}} disabled{{/opt.disabled}} value="{{opt.value}}"><label for="{{optionId}}">{{opt.label}}</label></div>{{/options}}</div>{{/radio}}{{#checkbox}}<input type="checkbox" id="{{field.id}}" name="{{field.name}}"{{#field.required}} required{{/field.required}}{{#field.disabled}} disabled{{/field.disabled}}{{#field.checked}} checked{{/field.checked}}{{#field.required}} aria-required="true"{{/field.required}}{{#hasError}} aria-invalid="true"{{/hasError}}{{#hasDescription}} aria-describedby="{{described}}"{{/hasDescription}}{{#field.value}} value="{{field.value}}"{{/field.value}}>{{/checkbox}}{{#input}}<input type="{{inputType}}" id="{{field.id}}" name="{{field.name}}"{{#field.required}} required{{/field.required}}{{#field.disabled}} disabled{{/field.disabled}}{{#field.placeholder}} placeholder="{{field.placeholder}}"{{/field.placeholder}}{{#field.readOnly}} readonly{{/field.readOnly}}{{#field.required}} aria-required="true"{{/field.required}}{{#hasError}} aria-invalid="true"{{/hasError}}{{#hasDescription}} aria-describedby="{{described}}"{{/hasDescription}}{{#field.value}} value="{{field.value}}"{{/field.value}}{{#field.autoComplete}} autocomplete="{{field.autoComplete}}"{{/field.autoComplete}}{{#field.min}} min="{{field.min}}"{{/field.min}}{{#field.max}} max="{{field.max}}"{{/field.max}}{{#field.minLength}} minlength="{{field.minLength}}"{{/field.minLength}}{{#field.maxLength}} maxlength="{{field.maxLength}}"{{/field.maxLength}}{{#field.pattern}} pattern="{{field.pattern}}"{{/field.pattern}}{{#field.step}} step="{{stepValue}}"{{/field.step}}>{{/input}}{{#hasHelp}}<span class="help-text" id="help-{{field.id}}">{{field.helpText}}</span>{{/hasHelp}}{{#hasError}}<div class="error-message" aria-live="polite" id="error-{{field.id}}">{{field.errorMessage}}</div>{{/hasError}}</div>{{/fields}}</fieldset>{{/sections}}<button type="submit"{{#data.isSubmitting}} disabled{{/data.isSubmitting}}>Submit Registration</button></form></div></body></html>