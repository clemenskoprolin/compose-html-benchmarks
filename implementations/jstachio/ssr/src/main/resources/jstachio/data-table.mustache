<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><title>{{data.title}}</title></head><body><div id="dashboard" data-page="data-table"><header class="page-header"><h1>{{data.title}}</h1><p>{{data.description}}</p></header><div class="filters-bar" role="search"><input type="search" id="table-search" placeholder="Search rows..." aria-label="Search rows"{{#data.searchQuery}} value="{{data.searchQuery}}"{{/data.searchQuery}}><div class="active-filters">{{#filters}}<span class="filter-badge" data-filter-key="{{key}}" data-filter-val="{{value}}">{{key}}: {{value}}</span>{{/filters}}</div></div><div class="selection-status" role="status" aria-live="polite">{{data.selectedRowCount}} items selected</div><table role="grid" aria-label="Data Table" aria-rowcount="{{data.totalRowCount}}" aria-colcount="{{columnCount}}"><thead><tr><th scope="col"><input type="checkbox" aria-label="Select all rows"></th>{{#headers}}<th scope="col" role="columnheader"{{#header.sortable}} class="{{cssClass}}"{{/header.sortable}}{{#header.id}} data-column-id="{{header.id}}"{{/header.id}}{{#header.sortable}} aria-sort="{{direction}}"{{/header.sortable}}>{{header.label}}</th>{{/headers}}</tr></thead><tbody>{{#rows}}<tr{{#row.selected}} class="row-selected"{{/row.selected}} data-row-id="{{row.id}}" data-status="{{row.status}}" aria-selected="{{row.selected}}"><td><input type="checkbox"{{#row.selected}} checked{{/row.selected}} aria-label="Select row {{row.id}}"></td>{{#cells}}<td data-column="{{cell.columnId}}" data-value="{{cell.rawValue}}"{{#hasTooltip}} aria-describedby="{{tooltipId}}"{{/hasTooltip}}>{{#cell.isStatus}}<span role="status" class="status-badge status-{{cell.rawValue}}">{{cell.displayValue}}</span>{{/cell.isStatus}}{{^cell.isStatus}}{{cell.displayValue}}{{/cell.isStatus}}{{#hasTooltip}}<span class="tooltip-text" style="display:none" id="{{tooltipId}}">{{cell.tooltip}}</span>{{/hasTooltip}}</td>{{/cells}}</tr>{{/rows}}</tbody></table><nav aria-label="Pagination"><ul class="pagination">{{#data.pages}}<li><a href="?page={{number}}"{{#isCurrent}} class="current-page"{{/isCurrent}} data-page="{{number}}" aria-label="Page {{number}}"{{#isCurrent}} aria-current="page"{{/isCurrent}}>{{number}}</a></li>{{/data.pages}}</ul></nav></div></body></html>