<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><title>{{data.title}}</title></head><body><div class="dashboard-container"><header class="dashboard-header"><h1>{{data.title}}</h1></header><div class="charts-grid"><div class="chart-wrapper" role="img" aria-label="Line chart showing {{data.lineChart.title}}"><h2>{{data.lineChart.title}}</h2><svg viewbox="0 0 800 400" width="100%" height="100%"><line x1="50" y1="350" x2="750" y2="350" stroke="#000" stroke-width="2"></line><line x1="50" y1="50" x2="50" y2="350" stroke="#000" stroke-width="2"></line><path fill="none" stroke="#3b82f6" stroke-width="3" d="{{data.lineChart.pathData}}"></path>{{#data.lineChart.points}}<circle r="4" fill="#1d4ed8" cx="{{x}}" cy="{{y}}"></circle>{{/data.lineChart.points}}{{#data.lineChart.xLabels}}<text y="370" text-anchor="middle" font-size="12" x="{{x}}">{{text}}</text>{{/data.lineChart.xLabels}}</svg></div><div class="chart-wrapper" role="img" aria-label="Bar chart showing {{data.barChart.title}}"><h2>{{data.barChart.title}}</h2><svg viewbox="0 0 600 400"><defs><lineargradient id="bar-grad" x1="0%" y1="100%" x2="0%" y2="0%"><stop offset="0%" stop-color="#34d399"></stop><stop offset="100%" stop-color="#059669"></stop></lineargradient></defs>{{#bars}}<rect fill="url(#bar-grad)" x="{{bar.x}}" y="{{bar.y}}" width="{{bar.width}}" height="{{bar.height}}"></rect><text text-anchor="middle" font-size="12" x="{{labelX}}" y="{{labelY}}">{{label}}</text>{{/bars}}</svg></div><div class="chart-wrapper" role="img" aria-label="Pie chart showing {{data.pieChart.title}}"><h2>{{data.pieChart.title}}</h2><svg viewbox="0 0 400 400"><g transform="translate(200, 200)">{{#data.pieChart.slices}}<path stroke="#fff" stroke-width="2" d="{{pathData}}" fill="{{color}}"></path>{{/data.pieChart.slices}}</g></svg></div><div class="chart-wrapper" role="img" aria-label="Gauge showing {{data.gauge.title}}"><h2>{{data.gauge.title}}</h2><svg viewbox="0 0 200 150"><path d="M 20 130 A 80 80 0 0 1 180 130" fill="none" stroke="#e5e7eb" stroke-width="20"></path><path fill="none" stroke="#ef4444" stroke-width="20" d="{{data.gauge.valuePathData}}"></path><line x1="100" y1="130" stroke="#374151" stroke-width="4" x2="{{data.gauge.needleX}}" y2="{{data.gauge.needleY}}"></line><circle cx="100" cy="130" r="8" fill="#374151"></circle><text x="100" y="145" text-anchor="middle" font-size="14" dominant-baseline="hanging">{{data.gauge.valueLabel}}</text></svg></div></div></div></body></html>