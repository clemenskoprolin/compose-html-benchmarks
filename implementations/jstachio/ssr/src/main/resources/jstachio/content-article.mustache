<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><title>{{data.title}}</title><meta name="description" content="{{data.excerpt}}"></head><body><nav aria-label="Breadcrumb"><ol>{{#data.breadcrumbs}}<li><a href="{{url}}"{{#isCurrent}} aria-current="page"{{/isCurrent}}>{{label}}</a></li>{{/data.breadcrumbs}}</ol></nav><main><article><header><h1>{{data.title}}</h1><div class="meta"><span>By {{data.author}}</span><time datetime="{{data.publishDateIso}}">{{data.publishDateFormatted}}</time><span>{{data.readingTimeMin}} min read</span></div><img loading="lazy" src="{{data.heroImage.url}}" alt="{{data.heroImage.alt}}" width="{{data.heroImage.width}}" height="{{data.heroImage.height}}"></header><nav aria-label="Table of contents"><h2>Table of Contents</h2><ul>{{#data.toc}}<li><a href="#{{targetId}}">{{title}}</a></li>{{/data.toc}}</ul></nav>{{#sections}}<section id="{{section.id}}"><h2>{{section.title}}</h2>{{#blocks}}{{#paragraph}}<p>{{block.content}}</p>{{/paragraph}}{{#code}}<pre><code data-language="{{language}}">{{block.content}}</code></pre>{{/code}}{{#image}}<img loading="lazy" src="{{url}}" alt="{{block.content}}">{{/image}}{{#link}}<p><a target="_blank" rel="noreferrer" href="{{url}}">{{block.content}}</a></p>{{/link}}{{/blocks}}</section>{{/sections}}<footer><ul class="tags">{{#data.tags}}<li><a href="/tags/{{.}}">{{.}}</a></li>{{/data.tags}}</ul></footer></article><aside aria-label="Related articles"><h3>Related Articles</h3><ul>{{#data.relatedArticles}}<li><a href="{{url}}">{{title}}</a></li>{{/data.relatedArticles}}</ul></aside></main><footer><p>© 2024 Benchmarks</p></footer></body></html>