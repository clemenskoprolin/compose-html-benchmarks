@import benchmarks.model.*
@param FormData data
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><title>${data.getTitle()}</title></head><body><div id="app-container" role="main"><h1>${data.getTitle()}</h1><form method="post" action="${data.getActionUrl()}" aria-label="${data.getFormLabel()}">@for(var section : data.getSections())<fieldset aria-labelledby="legend-${section.getId()}"><legend id="legend-${section.getId()}">${section.getTitle()}</legend>@for(var field : section.getFields())!{var described = ((field.getHelpText() != null ? "help-" + field.getId() + " " : "") + (field.getErrorMessage() != null ? "error-" + field.getId() : "")).trim();}<div class="form-group" id="group-${field.getId()}"><label for="${field.getId()}">${field.getLabel()}</label>@if(field.getType() == FormFieldType.SELECT)<select id="${field.getId()}" name="${field.getName()}" required="${field.getRequired()}" disabled="${field.getDisabled()}" multiple="${field.getMultiple()}" aria-required="${field.getRequired() ? "true" : null}" aria-invalid="${field.getErrorMessage() != null ? "true" : null}" aria-describedby="${described.isEmpty() ? null : described}">@if(field.getOptions() != null)@for(var opt : field.getOptions())<option selected="${opt.getSelected()}" disabled="${opt.getDisabled()}" value="${opt.getValue()}">${opt.getLabel()}</option>@endfor@endif</select>@elseif(field.getType() == FormFieldType.TEXTAREA)<textarea id="${field.getId()}" name="${field.getName()}" required="${field.getRequired()}" disabled="${field.getDisabled()}" readonly="${field.getReadOnly()}" placeholder="${field.getPlaceholder()}" aria-required="${field.getRequired() ? "true" : null}" aria-invalid="${field.getErrorMessage() != null ? "true" : null}" aria-describedby="${described.isEmpty() ? null : described}" minlength="${field.getMinLength()}" maxlength="${field.getMaxLength()}">${field.getValue()}</textarea>@elseif(field.getType() == FormFieldType.RADIO)<div role="radiogroup" aria-required="${field.getRequired() ? "true" : null}" aria-invalid="${field.getErrorMessage() != null ? "true" : null}" aria-describedby="${described.isEmpty() ? null : described}">!{int optionIndex = 0;}@if(field.getOptions() != null)@for(var opt : field.getOptions())<div><input type="radio" id="${field.getId()}-opt-${optionIndex}" name="${field.getName()}" checked="${opt.getSelected()}" disabled="${opt.getDisabled()}" value="${opt.getValue()}"><label for="${field.getId()}-opt-${optionIndex}">${opt.getLabel()}</label></div>!{optionIndex++;}@endfor@endif</div>@elseif(field.getType() == FormFieldType.CHECKBOX)<input type="checkbox" id="${field.getId()}" name="${field.getName()}" required="${field.getRequired()}" disabled="${field.getDisabled()}" checked="${field.getChecked()}" aria-required="${field.getRequired() ? "true" : null}" aria-invalid="${field.getErrorMessage() != null ? "true" : null}" aria-describedby="${described.isEmpty() ? null : described}" value="${field.getValue()}">@else<input type="${field.getType().name().toLowerCase(java.util.Locale.ROOT)}" id="${field.getId()}" name="${field.getName()}" required="${field.getRequired()}" disabled="${field.getDisabled()}" placeholder="${field.getPlaceholder()}" readonly="${field.getReadOnly()}" aria-required="${field.getRequired() ? "true" : null}" aria-invalid="${field.getErrorMessage() != null ? "true" : null}" aria-describedby="${described.isEmpty() ? null : described}" value="${field.getValue()}" autocomplete="${field.getAutoComplete()}" min="${field.getMin()}" max="${field.getMax()}" minlength="${field.getMinLength()}" maxlength="${field.getMaxLength()}" pattern="${field.getPattern()}" step="${field.getStep()}">@endif@if(field.getHelpText() != null)<span class="help-text" id="help-${field.getId()}">${field.getHelpText()}</span>@endif@if(field.getErrorMessage() != null)<div class="error-message" aria-live="polite" id="error-${field.getId()}">${field.getErrorMessage()}</div>@endif</div>@endfor</fieldset>@endfor<button type="submit" disabled="${data.isSubmitting()}">Submit Registration</button></form></div></body></html>