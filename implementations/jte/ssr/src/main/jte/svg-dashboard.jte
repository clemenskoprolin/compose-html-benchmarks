@import benchmarks.model.*
@param SvgDashboardData data
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><title>${data.getTitle()}</title></head><body><div class="dashboard-container"><header class="dashboard-header"><h1>${data.getTitle()}</h1></header><div class="charts-grid"><div class="chart-wrapper" role="img" aria-label="Line chart showing ${data.getLineChart().getTitle()}"><h2>${data.getLineChart().getTitle()}</h2><svg viewbox="0 0 800 400" width="100%" height="100%"><line x1="50" y1="350" x2="750" y2="350" stroke="#000" stroke-width="2"></line><line x1="50" y1="50" x2="50" y2="350" stroke="#000" stroke-width="2"></line><path fill="none" stroke="#3b82f6" stroke-width="3" d="${data.getLineChart().getPathData()}"></path>@for(var point : data.getLineChart().getPoints())<circle r="4" fill="#1d4ed8" cx="${point.getX()}" cy="${point.getY()}"></circle>@endfor@for(var label : data.getLineChart().getXLabels())<text y="370" text-anchor="middle" font-size="12" x="${label.getX()}">${label.getText()}</text>@endfor</svg></div><div class="chart-wrapper" role="img" aria-label="Bar chart showing ${data.getBarChart().getTitle()}"><h2>${data.getBarChart().getTitle()}</h2><svg viewbox="0 0 600 400"><defs><lineargradient id="bar-grad" x1="0%" y1="100%" x2="0%" y2="0%"><stop offset="0%" stop-color="#34d399"></stop><stop offset="100%" stop-color="#059669"></stop></lineargradient></defs>@for(var bar : data.getBarChart().getBars())!{
    var label = Double.toString(bar.getValue());
    if (label.endsWith(".0")) label = label.substring(0, label.length() - 2);
}<rect fill="url(#bar-grad)" x="${bar.getX()}" y="${bar.getY()}" width="${bar.getWidth()}" height="${bar.getHeight()}"></rect><text text-anchor="middle" font-size="12" x="${bar.getX() + bar.getWidth() / 2}" y="${bar.getY() - 10}">${label}</text>@endfor</svg></div><div class="chart-wrapper" role="img" aria-label="Pie chart showing ${data.getPieChart().getTitle()}"><h2>${data.getPieChart().getTitle()}</h2><svg viewbox="0 0 400 400"><g transform="translate(200, 200)">@for(var slice : data.getPieChart().getSlices())<path stroke="#fff" stroke-width="2" d="${slice.getPathData()}" fill="${slice.getColor()}"></path>@endfor</g></svg></div><div class="chart-wrapper" role="img" aria-label="Gauge showing ${data.getGauge().getTitle()}"><h2>${data.getGauge().getTitle()}</h2><svg viewbox="0 0 200 150"><path d="M 20 130 A 80 80 0 0 1 180 130" fill="none" stroke="#e5e7eb" stroke-width="20"></path><path fill="none" stroke="#ef4444" stroke-width="20" d="${data.getGauge().getValuePathData()}"></path><line x1="100" y1="130" stroke="#374151" stroke-width="4" x2="${data.getGauge().getNeedleX()}" y2="${data.getGauge().getNeedleY()}"></line><circle cx="100" cy="130" r="8" fill="#374151"></circle><text x="100" y="145" text-anchor="middle" font-size="14" dominant-baseline="hanging">${data.getGauge().getValueLabel()}</text></svg></div></div></div></body></html>