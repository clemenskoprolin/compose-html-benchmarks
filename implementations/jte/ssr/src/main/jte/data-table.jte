@import benchmarks.model.*
@param DataTableData data
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><title>${data.getTitle()}</title></head><body><div id="dashboard" data-page="data-table"><header class="page-header"><h1>${data.getTitle()}</h1><p>${data.getDescription()}</p></header><div class="filters-bar" role="search"><input type="search" id="table-search" placeholder="Search rows..." aria-label="Search rows" value="${data.getSearchQuery()}"><div class="active-filters">@for(var filter : data.getActiveFilters().entrySet())<span class="filter-badge" data-filter-key="${filter.getKey()}" data-filter-val="${filter.getValue()}">${filter.getKey()}: ${filter.getValue()}</span>@endfor</div></div><div class="selection-status" role="status" aria-live="polite">${data.getSelectedRowCount()} items selected</div><table role="grid" aria-label="Data Table" aria-rowcount="${data.getTotalRowCount()}" aria-colcount="${data.getHeaders().size()}"><thead><tr><th scope="col"><input type="checkbox" aria-label="Select all rows"></th>@for(var header : data.getHeaders())!{var direction = header.getId().equals(data.getSortColumnId()) ? data.getSortDirection() : "none";}<th scope="col" role="columnheader" class="${header.getSortable() ? "sortable" + (!direction.equals("none") ? " sorted-" + direction : "") : null}" data-column-id="${header.getId()}" aria-sort="${header.getSortable() ? direction : null}">${header.getLabel()}</th>@endfor</tr></thead><tbody>@for(var row : data.getRows())<tr class="${row.getSelected() ? "row-selected" : null}" data-row-id="${row.getId()}" data-status="${row.getStatus()}" aria-selected="${Boolean.toString(row.getSelected())}"><td><input type="checkbox" checked="${row.getSelected()}" aria-label="Select row ${row.getId()}"></td>@for(var cell : row.getCells())!{var tooltipId = cell.getTooltip() == null ? null : "tt-" + row.getId() + "-" + cell.getColumnId();}<td data-column="${cell.getColumnId()}" data-value="${cell.getRawValue()}" aria-describedby="${tooltipId}">@if(cell.isStatus())<span role="status" class="status-badge status-${cell.getRawValue()}">${cell.getDisplayValue()}</span>@endif@if(!(cell.isStatus()))${cell.getDisplayValue()}@endif@if(cell.getTooltip() != null)<span class="tooltip-text" style="display:none" id="${tooltipId}">${cell.getTooltip()}</span>@endif</td>@endfor</tr>@endfor</tbody></table><nav aria-label="Pagination"><ul class="pagination">@for(var page : data.getPages())<li><a href="?page=${page.getNumber()}" class="${page.isCurrent() ? "current-page" : null}" data-page="${page.getNumber()}" aria-label="Page ${page.getNumber()}" aria-current="${page.isCurrent() ? "page" : null}">${page.getNumber()}</a></li>@endfor</ul></nav></div></body></html>