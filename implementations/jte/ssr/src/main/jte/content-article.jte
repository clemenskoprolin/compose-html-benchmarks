@import benchmarks.model.*
@param ArticleData data
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><title>${data.getTitle()}</title><meta name="description" content="${data.getExcerpt()}"></head><body><nav aria-label="Breadcrumb"><ol>@for(var crumb : data.getBreadcrumbs())<li><a href="${crumb.getUrl()}" aria-current="${crumb.isCurrent() ? "page" : null}">${crumb.getLabel()}</a></li>@endfor</ol></nav><main><article><header><h1>${data.getTitle()}</h1><div class="meta"><span>By ${data.getAuthor()}</span><time datetime="${data.getPublishDateIso()}">${data.getPublishDateFormatted()}</time><span>${data.getReadingTimeMin()} min read</span></div><img loading="lazy" src="${data.getHeroImage().getUrl()}" alt="${data.getHeroImage().getAlt()}" width="${data.getHeroImage().getWidth()}" height="${data.getHeroImage().getHeight()}"></header><nav aria-label="Table of contents"><h2>Table of Contents</h2><ul>@for(var item : data.getToc())<li><a href="#${item.getTargetId()}">${item.getTitle()}</a></li>@endfor</ul></nav>@for(var section : data.getSections())<section id="${section.getId()}"><h2>${section.getTitle()}</h2>@for(var block : section.getBlocks())@if(block.getType() == BlockType.PARAGRAPH)<p>${block.getContent()}</p>@endif@if(block.getType() == BlockType.CODE)<pre><code data-language="${block.getLanguage() != null ? block.getLanguage() : "text"}">${block.getContent()}</code></pre>@endif@if(block.getType() == BlockType.IMAGE)<img loading="lazy" src="${block.getUrl() != null ? block.getUrl() : ""}" alt="${block.getContent()}">@endif@if(block.getType() == BlockType.LINK)<p><a target="_blank" rel="noreferrer" href="${block.getUrl() != null ? block.getUrl() : ""}">${block.getContent()}</a></p>@endif@endfor</section>@endfor<footer><ul class="tags">@for(var tag : data.getTags())<li><a href="/tags/${tag}">${tag}</a></li>@endfor</ul></footer></article><aside aria-label="Related articles"><h3>Related Articles</h3><ul>@for(var article : data.getRelatedArticles())<li><a href="${article.getUrl()}">${article.getTitle()}</a></li>@endfor</ul></aside></main><footer><p>© 2024 Benchmarks</p></footer></body></html>