@import benchmarks.model.*
@param PreactSearchResultsData data
<div class="search-results"><div>@for(var item : data.getItems())<div class="search-results-item"><h2>${item.getTitle()}</h2><div class="lvpic pic img left"><div class="lvpicinner full-width picW"><a class="img imgWr2" href="/buy/${item.getId()}"><img loading="lazy" src="${item.getImage()}" alt="${item.getTitle()}"></a></div></div><span class="price">${item.getPrice()}</span><button class="buy-now" type="button">Buy now!</button></div>@endfor</div><footer id="glbfooter" role="contentinfo" class="gh-w"><div><div id="rtm_html_1650"><div id="rtm_html_1651"></div><h2 class="gh-ar-hdn">Additional site navigation</h2><div id="gf-BIG" class="gffoot"><table class="gf-t"><tbody><tr>@for(var section : data.getFooterSections())<td><ul><li class="gf-li"><h3 class="gf-bttl">@if(section.getHeadingHref() == null)${section.getTitle()}@endif@if(section.getHeadingHref() != null)<a class="gf-bttl thrd" href="${section.getHeadingHref()}">${section.getTitle()}</a>@endif</h3></li>@for(var link : section.getLinks())<li class="gf-li"><a class="thrd" href="${link.getHref()}">${link.getLabel()}</a></li>@endfor</ul></td>@endfor</tr></tbody></table></div></div></div></footer></div>