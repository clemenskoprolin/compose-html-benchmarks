# Copy this file to tools/benchmarks.env and customize the values for your local machine.
# This file is ignored by Git and loaded automatically by compose-version.sh,
# run-benchmarks.sh, and benchmark scripts.

# -----------------------------------------------------------------------------
# Compose HTML checkout override
# -----------------------------------------------------------------------------
# Usually set with: ./tools/compose-version.sh /path/to/compose-multiplatform
# COMPOSE_HTML_CHECKOUT=/absolute/path/to/compose-multiplatform
# COMPOSE_HTML_REVISION=full-commit-sha
# COMPOSE_DEPENDENCIES_PATH=/absolute/path/to/optimizations/compose-wasm-optimized-v3


# -----------------------------------------------------------------------------
# Benchmark run defaults
# -----------------------------------------------------------------------------
# Discarded loads/renders before sampling (defaults: 1 for browser, 3 for SSR).
# Setting this overrides both benchmark types.
# BENCHMARK_WARMUPS=1

# Browser only: measured page loads per target and browser process (default: 3)
# BENCHMARK_RUNS=3

# Shared: fresh browser-process and SSR-worker repetitions (default: 3)
# BENCHMARK_REPETITIONS=3

# SSR only: timed sample groups and renders averaged within each group
# BENCHMARK_TRIALS=15
# BENCHMARK_ITERATIONS=100

# React runtime included in the minified browser and SSR artifacts.
# "development" retains React diagnostics while keeping esbuild minification enabled.
# Re-run ./tools/compose-version.sh --prepare after changing this value.
# BENCHMARK_REACT_MODE=production

# -----------------------------------------------------------------------------
# Browser harness configuration
# -----------------------------------------------------------------------------
# Browser channel: "chrome" (default, uses installed Google Chrome) or "chromium"
# BENCHMARK_BROWSER_CHANNEL=chrome

# Synthetic network/CPU throttling profile (defaults match mobile/desktop profile)
# BENCHMARK_CPU_THROTTLE=4
# BENCHMARK_LATENCY_MS=40
# BENCHMARK_DOWNLOAD_MBPS=10
# BENCHMARK_UPLOAD_MBPS=5

# Measure memory and CDP JS heap (default: true; set to false to skip)
# BENCHMARK_MEMORY=true

# Workloads and targets to benchmark (comma-separated)
# BENCHMARK_SCENARIOS=tailwind-catalog,form-app,data-table,svg-dashboard,content-article,hydrate1k,update10th1k,reorder1k,filter-list
# BENCHMARK_TARGETS=react,compose-wasm,compose-js
