#!/bin/bash
set -euo pipefail

SCRIPT_PATH="${BASH_SOURCE[0]}"
SCRIPT_DIR="${SCRIPT_PATH%/*}"
[[ "$SCRIPT_DIR" == "$SCRIPT_PATH" ]] && SCRIPT_DIR="."
SCRIPT_DIR="$(cd "$SCRIPT_DIR" && pwd)"
PORT="${BENCHMARK_PORT:-4173}"

usage() {
  printf '%s\n' \
    'Usage: ./preview [thymeleaf|react|compose-js|compose-wasm] [site]' \
    '' \
    'Preview a prepared site in the default browser.' \
    '' \
    'Sites:' \
    '  thymeleaf   tailwind-catalog, form-app, data-table, svg-dashboard, content-article' \
    '  react       tailwind-catalog, form-app, data-table, svg-dashboard, content-article,' \
    '              hydrate1k, update10th1k, reorder1k, filter-list' \
    '  compose-js  same sites as react' \
    '  compose-wasm same sites as react' \
    '' \
    'Set BENCHMARK_PORT to use a different local port. Set PREVIEW_NO_OPEN=true to' \
    'start the server and print the URL without opening a browser.'
}

if [[ $# -eq 1 && ( "$1" == "-h" || "$1" == "--help" ) ]]; then
  usage
  exit 0
fi

if [[ $# -ne 2 ]]; then
  usage >&2
  exit 1
fi

TARGET="$1"
[[ "$TARGET" == "thymfeaf" ]] && TARGET="thymeleaf"
SITE="$2"

case "$TARGET" in
  thymeleaf)
    SITES=(tailwind-catalog form-app data-table svg-dashboard content-article)
    ;;
  react|compose-js|compose-wasm)
    SITES=(tailwind-catalog form-app data-table svg-dashboard content-article hydrate1k update10th1k reorder1k filter-list)
    ;;
  *)
    echo "Unknown target: $1" >&2
    usage >&2
    exit 1
    ;;
esac

if [[ ! " ${SITES[*]} " == *" $SITE "* ]]; then
  echo "Unknown site for $TARGET: $SITE" >&2
  usage >&2
  exit 1
fi

if [[ ! "$PORT" =~ ^[0-9]+$ ]] || (( PORT < 1 || PORT > 65535 )); then
  echo "BENCHMARK_PORT must be a TCP port between 1 and 65535." >&2
  exit 1
fi

URL="http://127.0.0.1:${PORT}/${TARGET}/${SITE}"
health_url="http://127.0.0.1:${PORT}/health"
server_ready() {
  node --input-type=module -e 'try { const response = await fetch(process.argv[1]); process.exit(response.ok ? 0 : 1); } catch { process.exit(1); }' "$health_url"
}

server_pid=""
cleanup() {
  if [[ -n "$server_pid" ]]; then
    kill "$server_pid" 2>/dev/null || true
    wait "$server_pid" 2>/dev/null || true
  fi
}
trap cleanup EXIT INT TERM

if ! server_ready; then
  BENCHMARK_PORT="$PORT" node "$SCRIPT_DIR/harness/browser/server.mjs" &
  server_pid=$!
  for _ in {1..50}; do
    if server_ready; then
      break
    fi
    /bin/sleep 0.1
  done
  if ! server_ready; then
    echo "Preview server failed to start on port $PORT." >&2
    exit 1
  fi
fi

printf 'Previewing %s at %s\n' "$TARGET/$SITE" "$URL"
if [[ "${PREVIEW_NO_OPEN:-false}" != "true" ]]; then
  /usr/bin/open "$URL"
fi

if [[ -z "$server_pid" ]]; then
  printf 'Using the existing server on port %s. Press Ctrl-C to stop preview.\n' "$PORT"
  while true; do /bin/sleep 3600; done
fi
wait "$server_pid"